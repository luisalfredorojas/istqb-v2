# =====================================================================
# Secrets de las Edge Functions (Lemon Squeezy - Merchant of Record)
# Configúralos con:
#   supabase secrets set LEMONSQUEEZY_API_KEY=... LEMONSQUEEZY_STORE_ID=... etc.
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente.
# =====================================================================

# API key de Lemon Squeezy (Settings → API)
LEMONSQUEEZY_API_KEY=

# ID numérico de tu tienda (Settings → Stores, o en la URL del dashboard)
LEMONSQUEEZY_STORE_ID=

# Secret del webhook (Settings → Webhooks, al crear el endpoint)
LEMONSQUEEZY_WEBHOOK_SECRET=

# IDs de las "variants" de cada plan (Products → tu producto → Variants)
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_YEARLY=
LEMONSQUEEZY_VARIANT_LIFETIME=

# URL pública del frontend, para el redirect tras el pago (sin barra final)
# Ej: https://testifyhq.com
APP_URL=

# (Opcional) Restringe CORS a tu dominio en create-checkout
# ALLOWED_ORIGIN=https://testifyhq.com
