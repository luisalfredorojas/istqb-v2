# Variables del frontend (Vite)
#
# ⚠️ Todo lo que empiece por VITE_ se incrusta en el bundle público y es
# visible para cualquiera. Aquí SOLO pueden ir valores públicos.
# Nunca pongas la clave service_role ni ningún secreto de la pasarela de
# pago: esos van en los secrets de las Edge Functions de Supabase
# (ver supabase/functions/.env.example).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL pública de la app, sin barra final
VITE_APP_URL=http://localhost:5173
